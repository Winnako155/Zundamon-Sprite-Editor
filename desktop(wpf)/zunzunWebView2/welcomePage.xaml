<Window x:Class="zunzunWebView2.welcomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zunzunWebView2"
        mc:Ignorable="d"
        Title="welcomePage" Height="300" Width="600" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="{x:Null}">
    <Grid x:Name="grid">
        <Image Margin="0" Source="画板 1.png" Stretch="Fill" Width="600" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Rectangle x:Name="rectangle" Fill="#FF126132" HorizontalAlignment="Left" Height="10" Margin="25,273.664,0,0" VerticalAlignment="Top" Width="249.333" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform>
                <ScaleTransform x:Name="progressScale" ScaleX="0"/>
            </Rectangle.RenderTransform>
        </Rectangle>
    </Grid>
</Window>
