<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 内部音频捕获需要录音权限；画面录制本身不需要 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Android 9+ 前台服务；Android 14+ 必须声明 mediaProjection 专用权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Android 13+ 前台服务通知（不授予也能录制，只是通知可能不显示） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- 录制前台服务：Android 14+ 必须带 foregroundServiceType="mediaProjection" -->
        <service
            android:name=".ScreenRecordService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 透明的授权中转页：承接系统 MediaProjection 弹窗的 onActivityResult -->
        <activity
            android:name=".PermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 仅用于在应用启动时拿 ApplicationContext，不对外暴露 -->
        <provider
            android:name=".RecorderInitializer"
            android:authorities="${applicationId}.zunda.screenrecorder.init"
            android:exported="false" />
    </application>
</manifest>
